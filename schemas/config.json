    "ExperimentalConfig": {
      "properties": {
        "allow_nested": {
          "default": false,
          "description": "Allow launching herdr inside an existing herdr pane. Default: false.",
          "type": "boolean"
        },
        "cjk_ime_agents": {
          "default": [],
          "description": "Restrict `reveal_hidden_cursor_for_cjk_ime` to focused panes whose\ndetected agent matches one of these names (case-insensitive). Empty\nlist means apply to any focused pane. Unknown agent names are ignored;\nif the list contains no valid names, the reveal does not apply.\nAccepted names: pi, claude, codex, gemini, cursor, devin, cline,\nopencode, copilot, kimi, kiro, droid, amp, grok, hermes, kilo,\nqodercli, qoder, maki.\nDefault: empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cjk_ime_cursor_shape": {
          "$ref": "#/$defs/ImeCursorShape",
          "description": "Cursor shape rendered for the IME anchor when\n`reveal_hidden_cursor_for_cjk_ime` is enabled. Default: \"steady_block\"."
        },
        "kitty_graphics": {
          "default": false,
          "description": "Experimental local Kitty graphics rendering for attached clients. Default: false.",
          "type": "boolean"
        },
        "pane_history": {
          "default": false,
          "description": "Persist pane screen history to session-history.json. Default: false.",
          "type": "boolean"
        },
        "reveal_hidden_cursor_for_cjk_ime": {
          "default": false,
          "description": "Expose the focused pane's cursor anchor to the outer terminal even when\nthe pane requested `?25l`, so macOS native input methods keep tracking\nthe candidate window when TUIs paint their own cursor (Claude Code, pi,\ncodex, etc.). Default: false.\n\nWhen the pane reports no cursor position, falls back to the pane's\ntop-left so a stable IME anchor is always available.\n\nTrade-off when enabled: an extra hardware cursor will be visible in the\nouter terminal for apps that hide the cursor without painting a\nreplacement (vim normal mode, etc.). See #149.",
          "type": "boolean"
        },
        "switch_ascii_input_source_in_prefix": {
          "default": false,
          "description": "While prefix mode is active, temporarily switch the macOS host input\nsource to an ASCII-capable keyboard layout so prefix commands are read\nas ASCII even when a CJK IME is active, then restore the previous input\nsource when prefix mode exits. macOS only; a no-op elsewhere and a\nbest-effort no-op if the switch fails. Default: false.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
